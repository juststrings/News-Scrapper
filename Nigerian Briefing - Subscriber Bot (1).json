    {
      "parameters": {
        "chatId": "={{ $('Parse Command').item.json.chat_id }}",
        "text": "👋 *Welcome to the Nigerian Content Briefing!*\n\nYou're now subscribed. Every few hours I scan Nigerian news (Punch, Premium Times, Vanguard, Daily Post), Reddit (r/Nigeria, r/NigeriaTech) and X/Twitter, then send you AI-scored *content briefings* — each with a viral score, a summary, community sentiment, and 2 ready-to-use video reaction hooks.\n\n📋 *Commands*\n/start — subscribe (or resubscribe)\n/stop — pause briefings\n/help — show this message again\n\nSit tight — your first briefing will arrive on the next scheduled run. 🔥",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
