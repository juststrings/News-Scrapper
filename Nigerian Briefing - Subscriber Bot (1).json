    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = ($json.message) || {};\nconst chat = msg.chat || {};\nconst from = msg.from || {};\nconst text = String(msg.text || '').trim();\nconst lower = text.toLowerCase();\n\nlet command;\nif (lower.startsWith('/stop')) {\n  command = 'stop';\n} else if (lower.startsWith('/help')) {\n  command = 'help';\n} else {\n  command = 'start';\n}\n\nreturn {\n  chat_id: String(chat.id || from.id || ''),\n  first_name: from.first_name || chat.first_name || '',\n  username: from.username || chat.username || '',\n  text,\n  command,\n};"
      },
      "id": "c1d8d1c4-27b8-4b6d-b2d2-bbd988fad3d1",
