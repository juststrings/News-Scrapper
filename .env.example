# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API key for model evaluation
GROQ_API_KEY=your_groq_api_key_here

# Optional sqlite path
SUBSCRIBER_DB=subscribers.db

# Optional: Apify bearer token for X/Twitter scraping (apidojo/twitter-scraper-lite actor).
# Requires the actor to be activated (pricing accepted) on your Apify account, otherwise
# it silently returns demo placeholder data, which this code detects and ignores.
APIFY_BEARER_TOKEN=your_apify_bearer_token_here

# Optional: comma-separated Nitter instances used as a free fallback for X/Twitter posts via RSS
NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org,https://xcancel.com

# Optional: X/Twitter search query used against Apify and the Nitter instances above
X_SEARCH_QUERY="Nigeria" min_faves:50 -filter:replies

# Optional: DuckDuckGo search-dork query used to find indexed X/Twitter posts as another free fallback
X_DDG_SEARCH_QUERY=(Nigeria OR Nigerian) (Tinubu OR APC OR PDP OR INEC OR EFCC OR "National Assembly" OR Naira OR ASUU) (site:twitter.com OR site:x.com)


