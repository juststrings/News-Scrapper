# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API key for model evaluation
GROQ_API_KEY=your_groq_api_key_here

# Optional sqlite path
SUBSCRIBER_DB=subscribers.db

# Optional: comma-separated Nitter instances used to fetch X/Twitter posts via RSS
NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org,https://xcancel.com

# Optional: X/Twitter search query used against the Nitter instances above
X_SEARCH_QUERY="Nigeria" min_faves:50 -filter:replies


